# ============================================================================
# ESF Enterprise Platform — production environment
# Copy to ".env.production" and fill in real values. NEVER commit the real file.
#   cp .env.production.example .env.production
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production ...
# ============================================================================

# ---- Database --------------------------------------------------------------
POSTGRES_DB=esf
POSTGRES_USER=esf
# Use a long random password (e.g. openssl rand -hex 24):
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# App connection string. Host MUST be the compose service name "db".
DATABASE_URL=postgresql+psycopg2://esf:CHANGE_ME_strong_db_password@db:5432/esf

# ---- Security --------------------------------------------------------------
# Session signing key. REQUIRED in production — the app refuses to start if this
# is empty or the default. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_hex_chars

# ---- Application -----------------------------------------------------------
ENVIRONMENT=production
# Behind the bundled nginx (which sets X-Real-IP): trust it so per-IP login
# limits and audit records reflect the real client, not the proxy. Set to false
# only if the app is exposed directly (no reverse proxy).
TRUST_PROXY=true
# Uvicorn worker processes (CPU-bound PDF rendering benefits from a few).
# NOTE: the login rate-limiter is per-process; for strict limits use 1 worker
# or an external store (see TECHNICAL_DEBT.md TD-019).
WEB_CONCURRENCY=2
# Container timezone (affects logs and the document timestamp).
TZ=Asia/Bishkek

# ---- Public URLs -----------------------------------------------------------
# Absolute base URL for QR codes and the public verification link. This MUST be
# THIS deployment's own HTTPS host. The app refuses to start in production if it is
# empty or points at the official portal (salyk.kg): documents issued here are
# non-official and must verify against this host, not the state system.
PUBLIC_BASE_URL=https://esf.example.com

# Show the "DEMO · non-official document" watermark on every rendered form/PDF.
# Keep true unless you have a specific, deliberate reason to disable it.
SHOW_DEMO_WATERMARK=true

# ---- Logging ---------------------------------------------------------------
# Container logs go to stdout/stderr (captured by Docker json-file driver with
# rotation, see docker-compose.prod.yml). Uvicorn/access logs included.
# Optional uvicorn log level: info | warning | error
LOG_LEVEL=info

# ---- AIOS Core integration (optional) -------------------------------------
# Leave AIOS_ENABLED=false for a fully standalone deployment. Set to true only
# when an AIOS Core instance is reachable and you have issued credentials.
# In production, AIOS_BASE_URL MUST start with https:// (enforced at startup).
AIOS_ENABLED=false
AIOS_BASE_URL=https://aios.example.com
AIOS_TOKEN=CHANGE_ME_aios_token
AIOS_WORKSPACE_ID=CHANGE_ME_workspace_id
# Tenant guard: the AIOS identity claim's tenant_id must match this value.
# REQUIRED when AIOS_ENABLED=true in production — startup fails if left empty.
# Set to your AIOS tenant identifier (visible in your AIOS admin console).
AIOS_EXPECTED_TENANT_ID=CHANGE_ME_tenant_id

# ---- First admin (used once by scripts/create_admin.py) --------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
