# ============================================================================
# ESF Enterprise Platform — production environment
# Copy to ".env.production" and fill in real values. NEVER commit the real file.
#   cp .env.production.example .env.production
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production ...
# ============================================================================

# ---- Database --------------------------------------------------------------
POSTGRES_DB=esf
POSTGRES_USER=esf
# Use a long random password (e.g. openssl rand -hex 24):
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# App connection string. Host MUST be the compose service name "db".
DATABASE_URL=postgresql+psycopg2://esf:CHANGE_ME_strong_db_password@db:5432/esf

# ---- Security --------------------------------------------------------------
# Session signing key. REQUIRED in production — the app refuses to start if this
# is empty or the default. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_hex_chars

# ---- Application -----------------------------------------------------------
ENVIRONMENT=production
# Uvicorn worker processes (CPU-bound PDF rendering benefits from a few).
# NOTE: the login rate-limiter is per-process; for strict limits use 1 worker
# or an external store (see TECHNICAL_DEBT.md TD-019).
WEB_CONCURRENCY=2
# Container timezone (affects logs and the document timestamp).
TZ=Asia/Bishkek

# ---- Public URLs -----------------------------------------------------------
# Absolute base URL used in QR codes and the public verification link.
# For an authentic Kyrgyz ESF clone this is the GNS portal; for your own
# deployment set it to your public HTTPS host, e.g. https://esf.example.com
PUBLIC_BASE_URL=https://esf.salyk.kg

# ---- Logging ---------------------------------------------------------------
# Container logs go to stdout/stderr (captured by Docker json-file driver with
# rotation, see docker-compose.prod.yml). Uvicorn/access logs included.
# Optional uvicorn log level: info | warning | error
LOG_LEVEL=info

# ---- First admin (used once by scripts/create_admin.py) --------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
