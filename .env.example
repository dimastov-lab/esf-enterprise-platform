# Copy to .env and adjust for your environment.

# PostgreSQL (the only supported database). Driver: psycopg2.
DATABASE_URL=postgresql+psycopg2://esf:esf@localhost:5432/esf

# Signed-session secret. MUST be set to a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string

# Absolute base URL used to build scannable QR / public verification links.
# Leave empty in dev (QR encodes the bare /esf/check-esf?documentUUID=... path).
PUBLIC_BASE_URL=

# development | production. In production: no dev-admin seed, secure cookies, no /dev preview.
ENVIRONMENT=development
