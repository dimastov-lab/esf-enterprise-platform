# Copy to .env and adjust for your environment.

# PostgreSQL (the only supported database). Driver: psycopg2.
DATABASE_URL=postgresql+psycopg2://esf:esf@localhost:5432/esf

# Signed-session secret. MUST be set to a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string

# Absolute base URL used to build scannable QR / public verification links.
# Leave empty in dev (QR encodes the bare /esf/check-esf?documentUUID=... path).
PUBLIC_BASE_URL=

# development | production. Default is PRODUCTION (safe-by-default) — you MUST set
# this to "development" for local dev to get the dev-admin seed, /docs, /dev preview
# and non-secure cookies. Any other value (or unset) is treated as production.
ENVIRONMENT=development

# Trust reverse-proxy X-Real-IP for client-IP (rate-limit/audit). Keep false in
# dev / when the app is exposed directly; set true only behind a trusted proxy.
TRUST_PROXY=false
