# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# Tooling caches / artifacts
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets & local env
.env
.env.production
infra/nginx/certs/*.pem

# OS / editor
.DS_Store
.idea/
.vscode/

# Runtime data (keep the folders, ignore contents)
storage/*
logs/*
!storage/.gitkeep
!logs/.gitkeep

# Backend runtime output — generated PDFs / QR codes are never committed.
# No committed .gitkeep placeholder is needed: storage/qr is (re)created at
# runtime by qr_service (mkdir(parents=True, exist_ok=True)) and by the Dockerfile,
# and PDFs are rendered in-memory and streamed, never persisted to storage/pdf.
backend/storage/pdf/*
backend/storage/qr/*

# Personal legal / financial material — NOT part of the platform, never commit
/ПАКЕТ_ДОКАЗАТЕЛЬСТВ*/
/ПАКЕТ_НОТАРИУС/
/Доказательства_фото/
/Материалы_потерпевшего_для_адвоката.pdf
/Долг_Михаила_реестр.xlsx
/РП_Комплаенс_*.xlsx
/пост_контроль.xlsx
/Проект_обращения_в_Банк_России.docx

# Pitch deck & misc non-code binaries (not part of the ESF platform)
/deck.pdf
/deck.pptx
/heic2
/invest.py

# Review / scratch artifacts (626MB of audio, video, captured refs — not source)
/_review/

# uv is not this repo's package manager (hash-pinned requirements.lock is canonical);
# a stray `uv run` in backend/ generates this — never commit it
uv.lock
