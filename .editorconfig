# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file for the ESF Enterprise Platform.
root = true

# Defaults for every file.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python — 4-space indent; project style targets a max line length of 100.
# (Enforced by ruff; see backend/pyproject.toml / .ruff config.)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# Markdown — keep trailing whitespace (two trailing spaces = hard line break).
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# YAML (docker-compose, pre-commit, CI) — 2-space indent.
[*.{yml,yaml}]
indent_size = 2

# HTML / Jinja templates and JS/CSS assets — 2-space indent.
[*.{html,js,css}]
indent_size = 2

# Makefiles require real tabs.
[Makefile]
indent_style = tab
